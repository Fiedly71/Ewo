# Copiez ce fichier en .env.local et remplissez les valeurs.
# Sans PRINTIFY_* le site tourne en mode démo, sans STRIPE_* le paiement est simulé.

# Printify : Mon compte > Connexions > Jetons API. L'ID de boutique est dans l'URL de la boutique.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# true = la commande part directement en impression après paiement (sinon validation manuelle dans Printify)
PRINTIFY_AUTO_SEND_TO_PRODUCTION=false

# Stripe : Développeurs > Clés API, et un webhook vers /api/webhooks/stripe (événement checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=usd

# Adresse de livraison prédéfinie : toutes les commandes Printify y sont expédiées
SHIP_TO_FIRST_NAME=Ewo
SHIP_TO_LAST_NAME=Boutique
SHIP_TO_EMAIL=
SHIP_TO_PHONE=
SHIP_TO_COUNTRY=US
SHIP_TO_REGION=
SHIP_TO_ADDRESS1=
SHIP_TO_ADDRESS2=
SHIP_TO_CITY=
SHIP_TO_ZIP=

# Vêtements personnalisables (IDs du catalogue Printify, prix en centimes)
CUSTOM_TSHIRT_BLUEPRINT_ID=12
CUSTOM_TSHIRT_PROVIDER_ID=29
CUSTOM_TSHIRT_PRICE=2500
CUSTOM_HOODIE_BLUEPRINT_ID=77
CUSTOM_HOODIE_PROVIDER_ID=29
CUSTOM_HOODIE_PRICE=4500
